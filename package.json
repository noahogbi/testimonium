{
  "name": "testimonium",
  "version": "0.3.0",
  "description": "Verifies that each footnote's cited URL actually carries that footnote's claims. A claim checker, not a link checker.",
  "keywords": ["citations", "footnotes", "verification", "fact-checking", "cli"],
  "license": "MIT",
  "author": "Noah Ogbi",
  "repository": { "type": "git", "url": "git+https://github.com/noahogbi/testimonium.git" },
  "type": "module",
  "engines": { "node": ">=20" },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "bin": { "testimonium": "./dist/bin.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
